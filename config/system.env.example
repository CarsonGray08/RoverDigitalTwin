# This workstation's paths and addresses; everything else is config/rover_twin.toml.
# The scripts copy this file to config/system.env on first run. Edit that copy:
# git ignores it, so each account keeps its own. scripts/setup_workstation.sh
# writes ISAAC_SIM_ROOT and MAPPER_PYTHON there.

ISAAC_SIM_ROOT="$HOME/isaacsim/_build/linux-x86_64/release"
ROVER_IP=192.168.0.157
DASHBOARD_PORT=8090
# MAPPER_PYTHON defaults to this repo's .venv/bin/python.
